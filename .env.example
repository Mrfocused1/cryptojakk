# Port the single Node process listens on (serves the client AND /ws)
PORT=3000
# Optional. Public origin(s) of the site(s) allowed to open a WebSocket, e.g. https://jakk.example.com
# Comma-separated for several (e.g. a Vercel client plus this host): https://jakk.vercel.app,https://jakk.example.com
# When set, WebSocket upgrades from any other browser Origin are refused.
PUBLIC_ORIGIN=

# --- Client (Vite; read at BUILD time, e.g. set in the Vercel project settings) ---
# WebSocket endpoint of the multiplayer server. Leave unset to use same-origin /ws (single Node host or `npm run dev`).
# Solo games vs bots never need it. Example for a separately hosted server:
# VITE_WS_URL=wss://game.example.com/ws
VITE_WS_URL=
